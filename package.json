{
  "name": "anything",
  "version": "0.1.0",
  "description": "Open platform to repurpose Spotify CarThing into a versatile controller",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:client": "ts-node src/tests/test-client.ts",
    "cli:dev": "ts-node src/cli/index.ts",
    "cli:link": "npm run build && npm link"
  },
  "keywords": [
    "carthing",
    "spotify",
    "controller",
    "automation",
    "plugins"
  ],
  "author": "",
  "license": "MIT",
  "bin": {
    "anything": "./dist/cli/index.js"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.1",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1",
    "canvas": "^3.2.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "debug": "^4.4.3",
    "express": "^5.1.0",
    "inquirer": "^12.9.6",
    "node-hid": "^3.2.0",
    "node-osascript": "^2.1.0",
    "usb": "^2.16.0",
    "ws": "^8.18.3"
  }
}
